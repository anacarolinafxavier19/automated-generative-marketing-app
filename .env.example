# LLM (prototype uses Google Gemini; swap for Azure OpenAI in production)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: free-tier fallback for receiver web research when Gemini's Google
# Search grounding quota (separate and much stricter than plain generation) is
# exhausted. Sign up at https://app.tavily.com (no credit card). Leave blank to
# keep the default behavior (a 502 pointing at the receiver-PDF-upload workaround).
TAVILY_API_KEY=

# Local storage roots (swap for Blob Storage / Cosmos DB / Azure AI Search in production)
STORAGE_ROOT=./storage
VECTOR_STORE_PATH=./storage/vector_store
METADATA_DB_PATH=./storage/metadata.db

# Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=6

# Cost estimation for GET /metrics — approximate snapshot, not a live feed;
# see the dated comment above these fields in app/core/config.py before trusting them
GEMINI_INPUT_PRICE_USD_PER_MILLION=0.10
GEMINI_OUTPUT_PRICE_USD_PER_MILLION=0.40
USD_TO_EUR_RATE=0.88
